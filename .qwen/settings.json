{
  "permissions": {
    "deny": ["Bash(gh pr merge:*)", "Bash(git push --force:*)", "Bash(git push -f:*)"],
    "ask": ["Bash(git push:*)"]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [ { "type": "command",
                     "command": "bash \"$QWEN_PROJECT_DIR/scripts/task-journal-context.sh\"" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command",
                     "command": "node \"$QWEN_PROJECT_DIR/scripts/cost-capture.mjs\"" } ] }
    ]
  }
}
