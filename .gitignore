# Role definitions are synced here from agents/ by tools/sync-agents.mjs and deliberately not
# versioned (process/bootstrap-guide.md, step 4). .claude/commands/ and .claude/settings.json ARE
# versioned — they carry this repository's process commands and shared permissions.
.claude/agents/
.claude/settings.local.json
.claude/worktrees/

# Qwen Code, the same split as .claude/ above: .qwen/commands/ and .qwen/settings.json ARE
# versioned. .qwen/worktrees/ is that environment's own worktree location and never a task
# worktree — those go to ../Eko_CRM-<identifier>, outside any agent configuration directory.
.qwen/agents/
.qwen/settings.local.json
.qwen/worktrees/
.qwen/tmp/

# Task journal and role hand-offs, kept in each task worktree — a memory aid, never evidence.
.task/

# Python (backend/)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
mutants/

# Node / React (frontend/)
node_modules/
dist/
.vite/
*.local
*.tsbuildinfo
reports/
.stryker-tmp/

# Env / secrets: every .env* file, examples included (ADR-0004-C9); none is ever tracked.
# One `.env*` pattern, so `.env-dev`, `.env_pilot` and `.envrc` are ignored too, not only `.env.*`.
.env*

# OS
.DS_Store
Thumbs.db
