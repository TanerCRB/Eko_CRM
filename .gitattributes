# Normalise text files. Hooks and shell scripts must stay LF even on a Windows checkout, or the
# shebang ends in a carriage return and the hook fails with "bad interpreter" while still
# reporting as installed and letting every push through (process/bootstrap-guide.md, step 2).
* text=auto
.githooks/** text eol=lf
scripts/*.sh text eol=lf
*.sh text eol=lf
# EKO-1-14: files an image or the backup test double runs or reads as LF text, without a .sh
# suffix (a CR after the shebang stops the backup image from starting).
backup/eko-backup text eol=lf
backup/schedule text eol=lf
backend/tests/runtime/destination_double/* text eol=lf
