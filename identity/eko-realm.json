        },
        {
          "name": "query-users"
        },
        {
          "name": "query-groups"
        },
        {
          "name": "query-clients"
        },
        {
          "name": "realm-admin"
        },
        {
          "name": "impersonation"
        },
        {
          "name": "manage-realm"
        },
        {
          "name": "manage-clients"
        },
        {
          "name": "manage-events"
        },
        {
          "name": "manage-identity-providers"
        },
        {
          "name": "manage-authorization"
        },
        {
          "name": "create-client"
        },
        {
          "name": "view-realm"
        },
        {
          "name": "view-clients"
        },
        {
          "name": "view-events"
        },
        {
          "name": "view-identity-providers"
        },
        {
          "name": "view-authorization"
        }
      ],
      "eko-backend": [
        {
          "name": "rep"
        },
        {
          "name": "manager"
        },
        {
          "name": "administrator",
          "composite": true,
          "composites": {
            "client": {
              "realm-management": [
                "manage-users",
                "view-users",
                "query-users",
                "query-groups",
                "query-clients",
                "view-clients"
              ]
            }
          }
        }
      ]
