{
  "$description": "Eko_CRM design tokens, prototype P1. Mirrors assets/tokens.css (light theme; dark overrides under 'dark'). Format close to W3C Design Tokens: {$value, $type}.",
  "color": {
    "loam": {
      "900": { "$value": "#241c15", "$type": "color" },
      "700": { "$value": "#4a3c30", "$type": "color" },
      "500": { "$value": "#7a6a5c", "$type": "color" },
      "300": { "$value": "#b9aea3", "$type": "color" }
    },
    "frost": {
      "50": { "$value": "#f2f3f1", "$type": "color" },
      "100": { "$value": "#e7e9e5", "$type": "color" },
      "200": { "$value": "#d6d9d3", "$type": "color" }
    },
    "white": { "$value": "#ffffff", "$type": "color" },
    "rapeseed": {
      "500": { "$value": "#e6c21b", "$type": "color" },
      "200": { "$value": "#f6e7a0", "$type": "color" },
      "50": { "$value": "#fcf7dc", "$type": "color" }
    },
    "held": { "600": { "$value": "#2f6b3f", "$type": "color" }, "50": { "$value": "#e4f0e6", "$type": "color" } },
    "plan": { "600": { "$value": "#2c5a86", "$type": "color" }, "50": { "$value": "#e3edf6", "$type": "color" } },
    "alert": { "600": { "$value": "#b3261e", "$type": "color" }, "50": { "$value": "#fbe9e7", "$type": "color" } }
  },
  "role": {
    "bg": { "$value": "{color.frost.50}" },
    "surface": { "$value": "{color.white}" },
    "surface-sunk": { "$value": "{color.frost.100}" },
    "border": { "$value": "{color.frost.200}" },
    "border-strong": { "$value": "{color.loam.300}" },
    "text": { "$value": "{color.loam.900}" },
    "text-muted": { "$value": "{color.loam.500}" },
    "ink": { "$value": "{color.loam.900}" },
    "accent": { "$value": "{color.rapeseed.500}" },
    "accent-soft": { "$value": "{color.rapeseed.50}" },
    "focus": { "$value": "{color.plan.600}" }
  },
  "state": {
    "planned": { "fg": { "$value": "{color.plan.600}" }, "bg": { "$value": "{color.plan.50}" } },
    "held": { "fg": { "$value": "{color.held.600}" }, "bg": { "$value": "{color.held.50}" } },
    "cancelled": { "fg": { "$value": "{color.loam.500}" }, "bg": { "$value": "{color.frost.100}" } },
    "awaiting": { "fg": { "$value": "#6b5400", "$type": "color" }, "bg": { "$value": "{color.rapeseed.50}" } },
    "overdue": { "fg": { "$value": "{color.alert.600}" }, "bg": { "$value": "{color.alert.50}" } },
    "manager": { "fg": { "$value": "#5b3f7a", "$type": "color" }, "bg": { "$value": "#efe8f6", "$type": "color" } }
  },
  "dark": {
    "bg": { "$value": "#17130f", "$type": "color" },
    "surface": { "$value": "#211b16", "$type": "color" },
    "surface-sunk": { "$value": "#2b241e", "$type": "color" },
    "border": { "$value": "#3a3129", "$type": "color" },
    "border-strong": { "$value": "#5a4d41", "$type": "color" },
    "text": { "$value": "#efebe6", "$type": "color" },
    "text-muted": { "$value": "#b2a69a", "$type": "color" },
    "ink": { "$value": "#efe3b0", "$type": "color" },
    "focus": { "$value": "#8ab6e0", "$type": "color" }
  },
  "font": {
    "display": { "$value": ["Bricolage Grotesque", "Segoe UI", "system-ui", "sans-serif"], "$type": "fontFamily" },
    "body": { "$value": ["Atkinson Hyperlegible Next", "Atkinson Hyperlegible", "Segoe UI", "system-ui", "sans-serif"], "$type": "fontFamily" }
  },
  "fontSize": {
    "xs": { "$value": "13px", "$type": "dimension" },
    "sm": { "$value": "15px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "19.2px", "$type": "dimension" },
    "xl": { "$value": "23px", "$type": "dimension" },
    "2xl": { "$value": "27.6px", "$type": "dimension" },
    "3xl": { "$value": "39.8px", "$type": "dimension" }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "24px", "$type": "dimension" },
    "6": { "$value": "32px", "$type": "dimension" },
    "7": { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "control": { "$value": "6px", "$type": "dimension" },
    "surface": { "$value": "10px", "$type": "dimension" },
    "chip": { "$value": "999px", "$type": "dimension" }
  },
  "size": {
    "tap": { "$value": "44px", "$type": "dimension" },
    "rail": { "$value": "232px", "$type": "dimension" },
    "tabbar": { "$value": "64px", "$type": "dimension" }
  },
  "motion": {
    "ease": { "$value": [0.2, 0.7, 0.2, 1], "$type": "cubicBezier" },
    "fast": { "$value": "120ms", "$type": "duration" },
    "base": { "$value": "220ms", "$type": "duration" }
  },
  "breakpoint": {
    "dialogSheet": { "$value": "600px", "$type": "dimension", "$description": "below: dialogs become bottom sheets" },
    "rail": { "$value": "900px", "$type": "dimension", "$description": "at and above: side rail; below: top bar + tab bar" },
    "twoColumn": { "$value": "1000px", "$type": "dimension" }
  }
}
