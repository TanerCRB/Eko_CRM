{
  "$description": "Eko_CRM prototype P3 design tokens. Mirrors css/tokens.css. Light values; dark overrides under 'dark'. Shape close to the W3C Design Tokens draft.",
  "color": {
    "ink": { "$value": "#1c201e", "$type": "color", "$description": "text, primary outlines, selected tabs" },
    "band": { "$value": "#20302a", "$type": "color", "$description": "the dark green bar; also the manager attribution" },
    "bandRaised": { "$value": "#2c4237", "$type": "color" },
    "paper": { "$value": "#ffffff", "$type": "color", "$description": "page background" },
    "mist": { "$value": "#eef1ec", "$type": "color", "$description": "secondary surface: visit blocks, next-visit panel" },
    "mistDeep": { "$value": "#e1e6dd", "$type": "color" },
    "rule": { "$value": "#d3d8d0", "$type": "color", "$description": "dividers" },
    "ruleStrong": { "$value": "#a9b1a8", "$type": "color", "$description": "input borders, table head" },
    "muted": { "$value": "#5c665f", "$type": "color", "$description": "secondary text" },
    "signal": { "$value": "#c0202a", "$type": "color", "$description": "ONE meaning: needs a decision or is late. Never a button fill." },
    "signalWash": { "$value": "#fbe9ea", "$type": "color" },
    "field": { "$value": "#1f6e47", "$type": "color", "$description": "primary action and the Held / Done state" },
    "fieldWash": { "$value": "#e3f1e8", "$type": "color" },
    "amber": { "$value": "#9a6306", "$type": "color", "$description": "In progress, not yet in Google" },
    "amberWash": { "$value": "#fbf0d9", "$type": "color" },
    "link": { "$value": "#184f86", "$type": "color" }
  },
  "state": {
    "planned": { "fg": "{color.ink}", "bg": "{color.paper}" },
    "held": { "fg": "{color.field}", "bg": "{color.fieldWash}" },
    "cancelled": { "fg": "{color.muted}", "bg": "{color.mist}", "border": "dashed" },
    "awaiting": { "fg": "{color.signal}", "bg": "{color.signalWash}" },
    "late": { "fg": "{color.signal}", "bg": "{color.signalWash}" },
    "progress": { "fg": "{color.amber}", "bg": "{color.amberWash}" },
    "manager": { "fg": "#f3f5f1", "bg": "{color.band}" }
  },
  "dark": {
    "bg": "#141916", "surface2": "#1d2420", "surface3": "#27302b", "text": "#e8ece8", "textMuted": "#9ba69e",
    "border": "#303934", "borderStrong": "#55615a", "band": "#0d1310", "primary": "#3f9a6b", "signal": "#ea5e66",
    "signalWash": "#3a1b1e", "field": "#3f9a6b", "fieldWash": "#173827", "amber": "#d9a240", "amberWash": "#3a2c10", "link": "#8fb6e2"
  },
  "font": {
    "display": { "$value": ["Brygada 1918", "Georgia", "Times New Roman", "serif"], "$type": "fontFamily", "$description": "voice: titles, customer names, dashboard numbers" },
    "text": { "$value": ["Lato", "Segoe UI", "system-ui", "sans-serif"], "$type": "fontFamily", "$description": "work: body, forms, lists" }
  },
  "fontSize": {
    "13": "0.8125rem", "15": "0.9375rem", "16": "1rem", "20": "1.25rem", "25": "1.5625rem", "31": "1.953rem", "39": "2.441rem",
    "$description": "1.25 modular scale from 16px; body never below 15px except metadata"
  },
  "lineHeight": { "text": 1.5, "display": 1.15 },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "gutter": "16px", "measure": "66ch" },
  "radius": { "control": "4px", "chip": "2px", "sheet": "8px" },
  "shadow": { "sheet": "0 16px 40px rgba(28, 32, 30, 0.22)", "$description": "only floating layers: sheets, toasts, popovers" },
  "motion": { "easeOut": [0.2, 0.8, 0.2, 1], "quick": "140ms", "base": "240ms" },
  "size": { "band": "56px", "tap": "44px", "contentMax": "1240px" },
  "breakpoint": {
    "sheetToBottom": { "$value": "600px", "$description": "below: dialogs become bottom sheets; week title shrinks" },
    "bandNav": { "$value": "900px", "$description": "at and above: nav in the band, week board; below: menu button, day strip" },
    "twoColumn": { "$value": "1000px" }
  }
}
